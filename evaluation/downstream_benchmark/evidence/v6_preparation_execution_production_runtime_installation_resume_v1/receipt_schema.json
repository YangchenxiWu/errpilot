    },
    "canonical_state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_3_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "production_runtime_effectivity_pin_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "controller_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "enforcement_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "live_daemon_topology_observation_sha256": {
