{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:errpilot:downstream-benchmark:case:1",
  "title": "ErrPilot synthetic downstream-benchmark case specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_mode",
    "case_id",
    "source_project",
    "source_revision",
    "fixed_revision",
    "failing_command",
    "oracle_command",
    "oracle_expected_marker",
    "workspace_identity",
    "protected_items",
    "environment_identity",
    "sample_role",
    "protocol_version",
    "protocol_sha256",
    "run_spec_version",
    "run_spec_sha256",
    "errpilot_revision",
    "errpilot_configuration_sha256"
  ],
  "properties": {
    "schema_version": {"const": "EP-DB-CASE-1"},
    "execution_mode": {"const": "synthetic_validation"},
    "case_id": {"type": "string", "minLength": 1},
    "source_project": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "fixed_revision": {"type": "string", "minLength": 1},
    "failing_command": {"type": "string", "minLength": 1},
    "oracle_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "oracle_expected_marker": {"type": "string", "minLength": 1},
    "workspace_identity": {"$ref": "#/$defs/sha256"},
    "protected_items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/protectedItem"}
    },
    "environment_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable_id", "python_version", "dependency_identity"],
      "properties": {
        "immutable_id": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "dependency_identity": {"type": "string", "minLength": 1}
      }
    },
    "sample_role": {"const": "synthetic_fixture"},
    "protocol_version": {"const": "EP-DBP-1"},
    "protocol_sha256": {
      "const": "34e014a07821dc9dca52178874eef0b847aee7f048071fb4920864ae5d3bee93"
    },
    "run_spec_version": {"const": "EP-DBRS-1"},
    "run_spec_sha256": {
      "const": "29ab6f78739d0eeea1c2a774e62e2d133f173e160c3d247407970a80726f4406"
    },
    "errpilot_revision": {"type": "string", "minLength": 1},
    "errpilot_configuration_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protectedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "item_type", "mode", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "item_type": {"enum": ["file", "directory", "symlink"]},
        "mode": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "children_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
